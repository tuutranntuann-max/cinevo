# Sao chép file này thành .env (cùng thư mục) rồi chỉnh nếu cần. KHÔNG commit file .env.

# development (mặc định) hoặc production. Ở production, cấu hình yếu sẽ bị từ chối khởi động.
APP_ENV=development

# BẮT BUỘC ở production, tối thiểu 32 ký tự. Tạo khóa:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ở development nếu để trống, hệ thống tự sinh khóa ngẫu nhiên lưu ở backend/database/.dev_secret_key
# Giữ khóa ổn định và sao lưu an toàn: khóa này còn dùng để giải mã CCCD/địa chỉ hồ sơ nhân viên.
SECRET_KEY=
JWT_EXPIRES_HOURS=24

# Mặc định dùng SQLite tại backend/database/cinevo.db. Muốn chuyển PostgreSQL thì mở dòng dưới
# (và chạy: pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/cinevo

CORS_ORIGINS=http://localhost:5173

# Chỉ lắng nghe localhost. Debug sẽ TỰ TẮT nếu HOST khác localhost hoặc APP_ENV=production.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true

# Tùy chọn dự phòng: cấu hình OAuth trong file .env hoặc nhập trực tiếp ở trang Admin
# → Trợ lý gửi OTP. Bật Gmail API và dùng URI chuyển hướng được ghi trong README.
# Ứng dụng chỉ xin gmail.send; không yêu cầu mật khẩu Google và không đọc hộp thư.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/admin/gmail-assistant/callback
GMAIL_OAUTH_FRONTEND_URL=http://localhost:5173

# SMTP App Password là phương án tương thích cũ nếu chưa kết nối OAuth.
# Không dùng mật khẩu đăng nhập Gmail thông thường và không gửi mật khẩu qua chat.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=cinevoshop@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=cinevoshop@gmail.com

# Khi chưa kết nối Gmail OAuth hoặc cấu hình SMTP, development dùng mã demo;
# không dùng chế độ này để nhận người dùng thật. Khi gửi email, OTP luôn ngẫu nhiên
# và không trả mã về giao diện/API.
MOCK_OTP_CODE=123456
OTP_DEBUG_HINT=true

# Tính năng AI: TẠM TẮT theo lộ trình (chưa tích hợp AI). Code AI vẫn được giữ lại.
# Chỉ đổi thành true khi đã được cho phép bắt đầu giai đoạn AI.
FEATURE_AI=false

# Tìm poster phim qua TMDb trong trang quản trị (lấy API key từ TMDb).
# Đặt khóa thật trong file .env, không chia sẻ khóa hoặc commit file .env.
TMDB_API_KEY=

# Giới hạn số lần thử đăng nhập/OTP/đăng ký. Chỉ tắt khi chạy test.
RATELIMIT_ENABLED=true
