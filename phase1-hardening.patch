+"""Đặt vé: giá do server tính, chống đặt trùng ghế, quyền xem vé."""
+import threading
+from datetime import timedelta
+
+from app.extensions import db
+from app.models import Showtime
+from app.timeutil import local_now
+
+
+def book(client, headers, sid, seat_ids, foods=None, **extra):
+    return client.post("/api/bookings", headers=headers,
+                       json={"showtime_id": sid, "seat_ids": seat_ids, "foods": foods or [],
+                             "payment_method": "QR", **extra})
+
+
+def test_price_is_computed_by_server_and_client_price_ignored(client, auth, seat_info):
+    sid, seats = seat_info
+    standard = next(s for s in seats if s["type"] == "STANDARD")
+    r = book(client, auth("user"), sid, [standard["id"]], [{"food_id": 2, "quantity": 1}],
+             amount=1, total_amount=1, price=1)
+    assert r.status_code == 201
+    assert r.get_json()["total_amount"] == 90000 + 99000
+
+
+def test_vip_surcharge(client, auth, seat_info):
+    sid, seats = seat_info
+    vip = next(s for s in seats if s["type"] == "VIP")
+    assert book(client, auth("user"), sid, [vip["id"]]).get_json()["seat_amount"] == 110000
+
+
+def test_booking_requires_login(client, seat_info):
+    sid, seats = seat_info
+    assert book(client, {}, sid, [seats[0]["id"]]).status_code == 401
+
+
+def test_same_seat_cannot_be_booked_twice(client, auth, seat_info):
+    sid, seats = seat_info
+    assert book(client, auth("user"), sid, [seats[0]["id"]]).status_code == 201
+    r = book(client, auth("manager"), sid, [seats[0]["id"]])
+    assert r.status_code == 409 and r.get_json()["code"] == "SEAT_TAKEN"
+
+
+def test_partial_overlap_rejects_whole_booking(client, auth, seat_info):
+    sid, seats = seat_info
+    book(client, auth("user"), sid, [seats[0]["id"]])
+    assert book(client, auth("manager"), sid, [seats[0]["id"], seats[1]["id"]]).status_code == 409
+    free = client.get(f"/api/showtimes/{sid}/seats").get_json()["seats"]
+    assert next(s for s in free if s["id"] == seats[1]["id"])["booked"] is False   # ghế 2 không bị giữ nhầm
+
+
+def test_seat_race_only_one_booking_succeeds(app, tokens, seat_info):
+    """12 request đồng thời cùng một ghế -> đúng 1 vé hợp lệ."""
+    sid, seats = seat_info
+    results = []
+
+    def go():
+        c = app.test_client()
+        results.append(book(c, {"Authorization": f"Bearer {tokens['user']}"}, sid, [seats[5]["id"]]).status_code)
+
+    threads = [threading.Thread(target=go) for _ in range(12)]
+    [t.start() for t in threads]
+    [t.join() for t in threads]
+    assert results.count(201) == 1 and results.count(409) == 11, results
+
+
+def test_invalid_inputs_rejected(client, auth, seat_info):
+    sid, seats = seat_info
+    h, s = auth("user"), seats[0]["id"]
+    assert book(client, h, sid, [s], [{"food_id": 1, "quantity": -5}]).status_code == 400
+    assert book(client, h, sid, [s], [{"food_id": 1, "quantity": 999}]).status_code == 400
+    assert book(client, h, sid, [s], ["khong-phai-dict"]).status_code == 400
+    assert book(client, h, sid, [s, s]).status_code == 400            # ghế lặp
+    assert book(client, h, sid, []).status_code == 400
+    assert book(client, h, sid, list(range(1, 12))).status_code == 400  # quá 8 ghế
+    assert book(client, h, 999999, [s]).status_code == 404
+    assert client.post("/api/bookings", headers=h, json={"showtime_id": sid, "seat_ids": [s],
+                       "payment_method": "BITCOIN"}).status_code == 400
+
+
+def test_seat_from_other_room_rejected(client, auth, seat_info):
+    sid, seats = seat_info
+    other_sid = next(s["id"] for s in client.get("/api/showtimes?city=TP.HCM").get_json())
+    other_seats = client.get(f"/api/showtimes/{other_sid}/seats").get_json()["seats"]
+    assert book(client, auth("user"), sid, [other_seats[0]["id"]]).status_code == 400
+
+
+def test_cannot_book_started_showtime(app, client, auth, seat_info):
+    sid, seats = seat_info
+    with app.app_context():
+        db.session.get(Showtime, sid).start_time = local_now() - timedelta(minutes=1)
+        db.session.commit()
+    assert book(client, auth("user"), sid, [seats[0]["id"]]).status_code == 400
+
+
+def test_booking_visible_only_to_owner_or_staff(client, auth, register_payload, seat_info):
+    sid, seats = seat_info
+    code = book(client, auth("user"), sid, [seats[0]["id"]]).get_json()["code"]
+    assert client.get(f"/api/bookings/{code}", headers=auth("user")).status_code == 200
+    assert client.get(f"/api/bookings/{code}", headers=auth("manager")).status_code == 200
+    assert client.get(f"/api/bookings/{code}").status_code == 401
+    # một USER khác không được xem
+    client.post("/api/auth/register", json=register_payload)
+    tok = client.post("/api/auth/verify-otp", json={"email": register_payload["email"], "code": "123456"}).get_json()["token"]
+    assert client.get(f"/api/bookings/{code}", headers={"Authorization": f"Bearer {tok}"}).status_code == 404
+    assert client.get("/api/bookings/my", headers={"Authorization": f"Bearer {tok}"}).get_json() == []
+
+
+def test_payment_recorded_and_code_format(client, auth, seat_info):
+    sid, seats = seat_info
+    b = book(client, auth("user"), sid, [seats[0]["id"]]).get_json()
+    assert b["code"].startswith("CV") and len(b["code"]) == 10
+    assert b["payment"]["status"] == "PAID" and b["payment"]["amount"] == b["total_amount"]
diff --git a/backend/tests/test_rbac.py b/backend/tests/test_rbac.py
new file mode 100644
index 0000000..0e09010
--- /dev/null
+++ b/backend/tests/test_rbac.py
@@ -0,0 +1,48 @@
+"""Phân quyền backend: không tin frontend."""
+import jwt
+import pytest
+
+ENDPOINTS = [  # (url, anon, user, manager, admin)
+    ("/api/admin/users", 401, 403, 403, 200),
+    ("/api/admin/dashboard", 401, 403, 403, 200),
+    ("/api/admin/transactions", 401, 403, 403, 200),
+    ("/api/manager/dashboard", 401, 403, 200, 200),
+    ("/api/manager/bookings", 401, 403, 200, 200),
+    ("/api/bookings/my", 401, 200, 200, 200),
+]
+
+
+@pytest.mark.parametrize("url,anon,user,manager,admin", ENDPOINTS)
+def test_role_matrix(client, auth, url, anon, user, manager, admin):
+    for role, expected in ((None, anon), ("user", user), ("manager", manager), ("admin", admin)):
+        assert client.get(url, headers=auth(role)).status_code == expected, (url, role)
+
+
+def test_manager_cannot_create_manager_or_lock_users(client, auth):
+    assert client.post("/api/admin/managers", json={}, headers=auth("manager")).status_code == 403
+    assert client.patch("/api/admin/users/1/status", json={"status": "LOCKED"}, headers=auth("manager")).status_code == 403
+
+
+def test_forged_tokens_rejected(client, app):
+    forged = [jwt.encode({"sub": "3", "role": "ADMIN"}, key="", algorithm="none"),
+              jwt.encode({"sub": "3", "role": "ADMIN"}, "sai-khoa", algorithm="HS256"),
+              jwt.encode({"sub": "3", "role": "ADMIN"}, "dev-secret-change-me", algorithm="HS256"),  # khóa mặc định cũ
+              "abc.def.ghi", ""]
+    for t in forged:
+        assert client.get("/api/admin/users", headers={"Authorization": f"Bearer {t}"}).status_code == 401
+
+
+def test_role_in_token_is_not_trusted_over_database(client, app, auth):
+    """Token USER bị sửa role thành ADMIN (ký đúng khóa) vẫn không có quyền vì backend đọc role từ DB."""
+    token = jwt.encode({"sub": "1", "role": "ADMIN"}, app.config["SECRET_KEY"], algorithm="HS256")
+    assert client.get("/api/admin/users", headers={"Authorization": f"Bearer {token}"}).status_code == 403
+
+
+def test_expired_token_rejected(client, app):
+    token = jwt.encode({"sub": "3", "role": "ADMIN", "exp": 1}, app.config["SECRET_KEY"], algorithm="HS256")
+    assert client.get("/api/admin/users", headers={"Authorization": f"Bearer {token}"}).status_code == 401
+
+
+def test_admin_cannot_lock_self(client, auth):
+    me = client.get("/api/auth/me", headers=auth("admin")).get_json()["user"]["id"]
+    assert client.patch(f"/api/admin/users/{me}/status", json={"status": "LOCKED"}, headers=auth("admin")).status_code == 400
diff --git a/backend/tests/test_security.py b/backend/tests/test_security.py
new file mode 100644
index 0000000..6d691f4
--- /dev/null
+++ b/backend/tests/test_security.py
@@ -0,0 +1,73 @@
+"""Cấu hình an toàn: secret, debug, OTP, rate limit, header."""
+import pytest
+
+from app.config import get_run_settings, resolve_secret_key
+from tests.conftest import make_app
+
+
+def test_production_rejects_missing_or_weak_secret(tmp_path):
+    for bad in (None, "", "dev-secret-change-me", "ngan"):
+        with pytest.raises(RuntimeError):
+            resolve_secret_key(bad, True, tmp_path / "k")
+    assert resolve_secret_key("a" * 40, True, tmp_path / "k") == "a" * 40
+
+
+def test_dev_generates_random_persistent_secret_not_the_known_default(tmp_path):
+    f = tmp_path / "k"
+    k1 = resolve_secret_key("dev-secret-change-me", False, f)
+    assert k1 != "dev-secret-change-me" and len(k1) >= 32
+    assert resolve_secret_key(None, False, f) == k1      # dùng lại, không đổi mỗi lần chạy
+
+
+def test_debug_only_on_localhost_and_never_in_production():
+    assert get_run_settings({"HOST": "127.0.0.1"})[2] is True
+    assert get_run_settings({"HOST": "0.0.0.0"})[2] is False
+    assert get_run_settings({"HOST": "127.0.0.1", "FLASK_DEBUG": "false"})[2] is False
+
+
+def test_otp_hint_hidden_when_disabled(tmp_path, register_payload):
+    c = make_app(tmp_path, OTP_DEBUG_HINT=False).test_client()
+    assert "otp_hint" not in c.post("/api/auth/register", json=register_payload).get_json()
+
+
+def test_production_otp_is_random_not_fixed(tmp_path, register_payload):
+    app = make_app(tmp_path, MOCK_OTP_CODE="", OTP_DEBUG_HINT=True)
+    codes = set()
+    for i in range(3):
+        codes.add(app.test_client().post("/api/auth/register",
+                  json={**register_payload, "email": f"u{i}@x.com"}).get_json()["otp_hint"])
+    assert "123456" not in codes and len(codes) == 3
+
+
+def test_login_rate_limited(tmp_path):
+    c = make_app(tmp_path, RATELIMIT_ENABLED=True).test_client()
+    codes = [c.post("/api/auth/login", json={"email": "user@cinevo.vn", "password": f"sai{i}"}).status_code for i in range(12)]
+    assert codes[:10] == [401] * 10 and codes[10] == 429
+    r = c.post("/api/auth/login", json={"email": "user@cinevo.vn", "password": "User@123"})
+    assert r.status_code == 429 and "Retry-After" in r.headers          # đúng mật khẩu cũng bị chặn khi đã vượt giới hạn
+
+
+def test_otp_brute_force_blocked(tmp_path, register_payload):
+    c = make_app(tmp_path, RATELIMIT_ENABLED=True, MOCK_OTP_CODE="123456").test_client()
+    c.post("/api/auth/register", json=register_payload)
+    codes = [c.post("/api/auth/verify-otp", json={"email": register_payload["email"], "code": f"{i:06d}"}).status_code
+             for i in range(7)]
+    assert codes[:5] == [400] * 5 and codes[5:] == [429, 429]
+    # sau khi bị khóa, ngay cả mã ĐÚNG cũng không dùng được
+    assert c.post("/api/auth/verify-otp", json={"email": register_payload["email"], "code": "123456"}).status_code == 429
+
+
+def test_security_headers_and_cors(client):
+    r = client.get("/api/health")
+    assert r.headers["X-Content-Type-Options"] == "nosniff" and r.headers["X-Frame-Options"] == "DENY"
+    evil = client.options("/api/movies", headers={"Origin": "http://evil.com", "Access-Control-Request-Method": "GET"})
+    assert evil.headers.get("Access-Control-Allow-Origin") is None
+
+
+def test_request_body_size_limited(client):
+    r = client.post("/api/auth/login", data="x" * (2 * 1024 * 1024), content_type="application/json")
+    assert r.status_code == 413
+
+
+def test_times_are_utc_marked(client, auth):
+    assert client.get("/api/auth/me", headers=auth("user")).get_json()["user"]["created_at"].endswith("Z")
diff --git a/backend/tests/test_validation.py b/backend/tests/test_validation.py
